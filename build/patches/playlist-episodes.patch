+++ b/connect/src/context_resolver.rs
@@ -214,7 +214,13 @@ impl ContextResolver {
 
         match next.update {
             ContextType::Default => {
-                let mut ctx = self.session.spclient().get_context(resolve_uri).await;
+                // a playlist comes from the playlist service: context resolve leaves out the
+                // podcast episodes of one that mixes them with tracks
+                let playlist = crate::playlist_context::resolve(&self.session, resolve_uri).await;
+                let mut ctx = match playlist {
+                    Some(ctx) => Ok(ctx),
+                    None => self.session.spclient().get_context(resolve_uri).await,
+                };
                 if let Ok(ctx) = ctx.as_mut() {
                     ctx.uri = Some(next.context_uri().to_string());
                     ctx.url = ctx.uri.as_ref().map(|s| format!("context://{s}"));
